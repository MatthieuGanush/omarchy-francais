+function isFrench() {
+  return String(Qt.locale().name).indexOf("fr") === 0
+}
+
+function t(source) {
+  var text = isFrench() && fr.hasOwnProperty(source) ? fr[source] : source
+  for (var i = 1; i < arguments.length; i++)
+    text = text.split("%" + i).join(String(arguments[i]))
+  return text
+}
+
+// Qt's French abbreviations carry a dot ("lun."); the calendar header wants bare words.
+function shortDay(locale, weekday) {
+  return String(locale.dayName(weekday, 1 /* Locale.ShortFormat */)).replace(/\.$/, "")
+}
